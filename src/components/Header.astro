---
import SearchBar from './SearchBar.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';

interface Props {
  currentLang: 'pt' | 'en';
  canonicalSlug?: string;
  hasAlternateLang?: boolean;
}

const { currentLang, canonicalSlug, hasAlternateLang } = Astro.props;
---

<header class="site-header">
  <button id="mobile-menu-toggle" class="toggle-btn mobile-menu-btn" aria-label="Abrir menu de threads" type="button">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="4" x2="20" y1="12" y2="12"></line>
      <line x1="4" x2="20" y1="6" y2="6"></line>
      <line x1="4" x2="20" y1="18" y2="18"></line>
    </svg>
    <span>Menu</span>
  </button>

  <SearchBar currentLang={currentLang} />

  <div class="header-controls">
    <LanguageToggle
      currentLang={currentLang}
      canonicalSlug={canonicalSlug}
      hasAlternateLang={hasAlternateLang}
    />
    <ThemeToggle />
  </div>
</header>
