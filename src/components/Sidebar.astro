---
interface ThreadCount {
  name: string;
  count: number;
}

interface Props {
  threads: ThreadCount[];
  currentLang: 'pt' | 'en';
  activeThread?: string;
}

const { threads, currentLang, activeThread } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const threadsTitle = currentLang === 'pt' ? 'Tópicos / Threads' : 'Threads / Topics';
const allPostsLabel = currentLang === 'pt' ? 'Todos os posts' : 'All posts';
---

<aside id="sidebar-drawer" class="sidebar">
  <div class="sidebar-brand">
    <div class="logo-icon">T</div>
    <a href={`${baseUrl}${currentLang}/`}>Thoughts</a>
  </div>

  <nav aria-label="Navegação por tópicos">
    <div class="threads-title">{threadsTitle}</div>
    <ul class="threads-list">
      <li>
        <a
          href={`${baseUrl}${currentLang}/`}
          class={`thread-link ${!activeThread ? 'active' : ''}`}
        >
          <span>{allPostsLabel}</span>
        </a>
      </li>
      {threads.map(t => (
        <li>
          <a
            href={`${baseUrl}${currentLang}/?thread=${encodeURIComponent(t.name)}`}
            class={`thread-link ${activeThread === t.name ? 'active' : ''}`}
          >
            <span>#{t.name}</span>
            <span class="thread-count">{t.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<div id="sidebar-overlay" class="sidebar-overlay"></div>

<script>
  function setupSidebarDrawer() {
    const mobileBtn = document.getElementById('mobile-menu-toggle');
    const sidebar = document.getElementById('sidebar-drawer');
    const overlay = document.getElementById('sidebar-overlay');

    if (!mobileBtn || !sidebar || !overlay) return;

    function toggleMenu() {
      sidebar.classList.toggle('open');
      overlay.classList.toggle('open');
    }

    function closeMenu() {
      sidebar.classList.remove('open');
      overlay.classList.remove('open');
    }

    mobileBtn.addEventListener('click', toggleMenu);
    overlay.addEventListener('click', closeMenu);

    document.querySelectorAll('.thread-link').forEach(link => {
      link.addEventListener('click', closeMenu);
    });
  }

  setupSidebarDrawer();
  document.addEventListener('astro:after-swap', setupSidebarDrawer);
</script>
