---
import BaseLayout from './BaseLayout.astro';
import type { ProcessedPost } from '../utils/posts';

interface Props {
  post: ProcessedPost;
}

const { post } = Astro.props;
const formattedDate = new Date(post.date).toLocaleDateString(post.lang === 'pt' ? 'pt-BR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const translationNotice = post.lang === 'pt'
  ? 'Este post está disponível atualmente apenas em português.'
  : 'This post is currently only available in English.';
---

<BaseLayout
  title={post.title}
  description={post.summary}
  lang={post.lang}
  canonicalSlug={post.slug}
  hasAlternateLang={post.hasAlternateLang}
>
  <article class="post-detail-container">
    <!-- Espaço de Banner Reservado no Topo -->
    <div class="post-header-banner">
      {post.bannerUrl ? (
        <img src={post.bannerUrl} alt={`Banner de destaque do post: ${post.title}`} />
      ) : (
        <div class="banner-placeholder">
          <span>Sem imagem de banner ainda</span>
        </div>
      )}
    </div>

    <!-- Metadados e Título -->
    <header>
      <h1 class="post-title">{post.title}</h1>
      <div class="post-meta-bar">
        <time datetime={post.date.toISOString()}>{formattedDate}</time>
        <span>•</span>
        {post.threads.map(t => (
          <span class="thread-tag">#{t}</span>
        ))}
      </div>
    </header>

    <!-- Aviso de Tradução Ausente (se aplicável) -->
    {!post.hasAlternateLang && (
      <div class="translation-notice" role="alert">
        ℹ️ {translationNotice}
      </div>
    )}

    <!-- Conteúdo em Markdown -->
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
