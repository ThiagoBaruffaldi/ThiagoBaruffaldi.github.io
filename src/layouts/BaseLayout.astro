---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { getThreadsWithCount } from '../utils/posts';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang: 'pt' | 'en';
  activeThread?: string;
  canonicalSlug?: string;
  hasAlternateLang?: boolean;
}

const {
  title,
  description = 'Blog Pessoal Estático com autoria em Markdown',
  lang,
  activeThread,
  canonicalSlug,
  hasAlternateLang,
} = Astro.props;

const threads = await getThreadsWithCount(lang);
---

<!DOCTYPE html>
<html lang={lang} data-theme="dark">
  <head>
    <BaseHead
      title={title}
      description={description}
      lang={lang}
      canonicalSlug={canonicalSlug}
    />
  </head>
  <body>
    <div class="layout-container">
      <Sidebar
        threads={threads}
        currentLang={lang}
        activeThread={activeThread}
      />

      <main class="main-content">
        <Header
          currentLang={lang}
          canonicalSlug={canonicalSlug}
          hasAlternateLang={hasAlternateLang}
        />

        <slot />

        <Footer currentLang={lang} />
      </main>
    </div>
  </body>
</html>
